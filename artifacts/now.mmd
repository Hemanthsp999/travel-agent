---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	observe(observe)
	decide(decide)
	hotel(hotel)
	flight(flight)
	reobserve(reobserve)
	respond(respond)
	__end__([<p>__end__</p>]):::last
	__start__ --> observe;
	decide -.-> flight;
	decide -.-> hotel;
	decide -.-> respond;
	flight --> reobserve;
	hotel --> reobserve;
	observe --> decide;
	reobserve -.-> observe;
	reobserve -.-> respond;
	respond --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
